vif_model = lm(log_revenue ~ marketing_budget_usd + ad_spend_online_usd + ad_spend_offline_usd +
num_promotions + discount_percentage + num_sales_representatives +
customer_age + customer_satisfaction_score + competitor_price_index +
website_traffic + conversion_rate + email_open_rate +
social_media_followers + days_since_last_purchase + num_previous_purchases +
online_share + budget_utilization + purchase_frequency +
region + product_category + season + customer_segment + sales_channel,
data = dataset_clean)
# Računanje VIF-a (koristimo generalizovani VIF - GVIF koji ispravno tretira i kategorijske promenljive sa više nivoa)
vif_values = vif(vif_model)
print("--- GVIF vrednosti za sva feature-a  ---")
print(round(vif_values, 2))
gvif_column = vif_values[, "GVIF"]
high_vif_features = names(gvif_column[gvif_column > 10])
print("Feature sa visokim VIF-om (> 10) koja zahtevaju pažnju:")
print(high_vif_features)
selected_features = names(gvif_column[gvif_column <= 10])
print("Konačna lista stabilnih feature-a nakon uklanjanja multikolinearnosti:")
print(selected_features)
selected_features = setdiff(selected_features, "ad_spend_offline_usd")
print("Konačna lista stabilnih feature-a nakon uklanjanja multikolinearnosti:")
print(selected_features)
feature_selection_summary = data.frame(
Feature = names(gvif_column),
VIF = round(gvif_column, 2),
Status = ifelse(gvif_column > 9, "Eliminisano / Redundantno", "Zadržano")
)
print(feature_selection_summary)
numeric_features = selected_features[sapply(dataset_clean[selected_features], is.numeric)]
spearman_corrs = sapply(numeric_features, function(feat) {
if(sd(dataset_clean[[feat]], na.rm = TRUE) == 0) {
return(NA)
}
cor(dataset_clean[[feat]], dataset_clean$log_revenue, method = "spearman", use = "complete.obs")
})
spearman_ranking = data.frame(
Feature = names(spearman_corrs),
Spearman_Rho = round(spearman_corrs, 4),
Abs_Correlation = round(abs(spearman_corrs), 4)
)
spearman_ranking = na.omit(spearman_ranking)
spearman_ranking = spearman_ranking[order(-spearman_ranking$Abs_Correlation), ]
rownames(spearman_ranking) = NULL
print(spearman_ranking)
categorical_features = selected_features[sapply(dataset_clean[selected_features], function(x) is.factor(x) || is.character(x))]
calculate_eta_sq = function(feat, target, data) {
aov_model = aov(data[[target]] ~ as.factor(data[[feat]]))
summary_aov = summary(aov_model)[[1]]
ss_effect = summary_aov["Sum Sq"][1, 1]
ss_total = sum(summary_aov["Sum Sq"])
return(ss_effect / ss_total)
}
effect_sizes = sapply(categorical_features, function(feat) {
calculate_eta_sq(feat, "log_revenue", dataset_clean)
})
categorical_ranking = data.frame(
Feature = names(effect_sizes),
Eta_Squared = round(effect_sizes, 4)
)
categorical_ranking = categorical_ranking[order(-categorical_ranking$Eta_Squared), ]
rownames(categorical_ranking) = NULL
print(categorical_ranking)
weak_numeric = spearman_ranking$Feature[spearman_ranking$Abs_Correlation < 0.05]
print("Identifikovani slabi numerički prediktori:")
print(weak_numeric)
weak_categorical = categorical_ranking$Feature[categorical_ranking$Eta_Squared < 0.01]
print("Identifikovani slabi kategorijski prediktori:")
print(weak_categorical)
final_features = setdiff(selected_features, c(weak_numeric, weak_categorical))
print("Konačna lista feature-a nakon statističke selekcije:")
print(final_features)
formula_full = as.formula(paste("log_revenue ~", paste(names(dataset_clean)[names(dataset_clean) != "log_revenue"], collapse = " + ")))
model_full = lm(formula_full, data = dataset_clean)
formula_selected = as.formula(paste("log_revenue ~", paste(final_features, collapse = " + ")))
model_selected = lm(formula_selected, data = dataset_clean)
comparison_summary = data.frame(
Model = c("Full Model (Svi feature-i)", "Selected Model (Redukovan skup)"),
Number_of_Features = c(length(coef(model_full)) - 1, length(coef(model_selected)) - 1),
Adjusted_R2 = c(summary(model_full)$adj.r.squared, summary(model_selected)$adj.r.squared),
AIC = c(AIC(model_full), AIC(model_selected))
)
print(comparison_summary)
set.seed(123)
rf_model = randomForest(log_revenue ~ .,
data = dataset_clean[, c(final_features, "log_revenue")],
ntree = 150,
importance = TRUE)
rf_imp = importance(rf_model, type = 1)
rf_ranking = data.frame(
Feature = rownames(rf_imp),
Importance = round(rf_imp[, 1], 4)
)
rf_ranking = rf_ranking[order(-rf_ranking$Importance), ]
rownames(rf_ranking) = NULL
print(head(rf_ranking, 10))
x_mat = model.matrix(log_revenue ~ ., data = dataset_clean[, c(final_features, "log_revenue")])[, -1]
y_vec = dataset_clean$log_revenue
set.seed(42)
cv_lasso = cv.glmnet(x_mat, y_vec, alpha = 1, nfolds = 5)
best_lambda = cv_lasso$lambda.min
lasso_model = glmnet(x_mat, y_vec, alpha = 1, lambda = best_lambda)
lasso_coefs = coef(lasso_model)
lasso_selected_dummies = rownames(lasso_coefs)[lasso_coefs[, 1] != 0]
lasso_selected_dummies = setdiff(lasso_selected_dummies, "(Intercept)")
print(paste("Broj selektovanih feature-a nakon Lasso regularizacije je :",length(lasso_selected_dummies)))
rf_top_features = rf_ranking$Feature[rf_ranking$Importance > 10]
lasso_original_features = unique(sapply(lasso_selected_dummies, function(col) {
matched = final_features[sapply(final_features, function(f) grepl(f, col))]
if(length(matched) > 0) return(matched[1]) else return(col)
}))
final_model_features = intersect(intersect(final_features, rf_top_features), lasso_original_features)
if(length(final_model_features) == 0) {
final_model_features = intersect(final_features, rf_top_features)
}
print("Konačna lista feature-a za mašinsko učenje (Final Feature List):")
print(final_model_features)
print(paste("Ukupan broj feature-a u konačnom skupu:", length(final_model_features)))
ml_features_data = dataset_clean[, c(final_model_features, "log_revenue", "sales_revenue_usd")]
print(paste("Ukupan broj feature-a pripremljenih za modelovanje:", length(final_model_features)))
print(paste("Dimenzije matrice za mašinsko učenje:", nrow(ml_features_data), "redova i", ncol(ml_features_data), "kolona"))
set.seed(123)
train_sample_index = sample(1:nrow(ml_features_data), size = 0.8 * nrow(ml_features_data))
train_set = ml_features_data[train_sample_index, ]
test_set  = ml_features_data[-train_sample_index, ]
print(paste("Broj instanci u trening setu (80%):", nrow(train_set)))
print(paste("Broj instanci u test setu (20%):", nrow(test_set)))
train_target_summary = summary(train_set$log_revenue)
test_target_summary  = summary(test_set$log_revenue)
print("--- Statistika log_revenue u Trening setu ---")
print(train_target_summary)
print("--- Statistika log_revenue u Test setu ---")
print(test_target_summary)
split_distribution_df = bind_rows(
mutate(train_set, Split_Group = "Train Set (80%)"),
mutate(test_set,  Split_Group = "Test Set (20%)")
)
ggplot(split_distribution_df, aes(x = log_revenue, fill = Split_Group)) +
geom_density(alpha = 0.6, color = "#2C3E50") +
theme_minimal() +
labs(title = "Poređenje gustine raspodele log_revenue između Train i Test seta",
x = "Log Revenue",
y = "Gustina") +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 11),
legend.title = element_blank())
numeric_features = names(train_set)[sapply(train_set, is.numeric)]
numeric_features = setdiff(numeric_features, c("log_revenue", "sales_revenue_usd"))
categorical_features = names(train_set)[sapply(train_set, function(x) is.factor(x) || is.character(x))]
print(paste("Broj numeričkih prediktora za obradu:", length(numeric_features)))
print(paste("Broj kategorijskih prediktora za kodiranje:", length(categorical_features)))
for(col in categorical_features) {
train_set[[col]] = as.factor(train_set[[col]])
test_set[[col]]  = factor(test_set[[col]], levels = levels(train_set[[col]]))
}
# Izračunavanje srednje vrednosti i standardne devijacije ISKLJUČIVO na trening setu
train_means = sapply(train_set[, numeric_features, drop=FALSE], mean, na.rm = TRUE)
train_sds   = sapply(train_set[, numeric_features, drop=FALSE], sd, na.rm = TRUE)
# Funkcija za primenu skaliranja
scale_features = function(df, features, means, sds) {
df_scaled = df
for(col in features) {
if(sds[col] > 0) {
df_scaled[[col]] = (df[[col]] - means[col]) / sds[col]
}
}
return(df_scaled)
}
train_set_processed = scale_features(train_set, numeric_features, train_means, train_sds)
test_set_processed  = scale_features(test_set, numeric_features, train_means, train_sds)
print(paste("Dimenzije obrađenog trening seta:", nrow(train_set_processed), "redova,", ncol(train_set_processed), "kolona"))
print(paste("Dimenzije obrađenog test seta:", nrow(test_set_processed), "redova,", ncol(test_set_processed), "kolona"))
print("Preprocessing Pipeline je uspešno završen spreman za treniranje modela.")
# Konfiguracija 5-fold CV kontrole
train_control = trainControl(
method = "cv",
number = 5,
savePredictions = "final",
verboseIter = FALSE
)
cv_summary_table = data.frame(
Parametar = c("Metod validacije", "Broj foldova (K)", "Evaluacione metrike", "Praćenje rezultata", "Čuvanje predikcija"),
Vrednost = c("Cross-Validation (cv)", "5", "RMSE, MAE, R-squared", "Mean i Standardna devijacija (SD)", "final")
)
knitr::kable(cv_summary_table, caption = "Konfigurisani parametri i metrike unakrsne validacije")
baseline_mean_val = mean(train_set$log_revenue, na.rm = TRUE)
# Kreiranje vektora predikcija za test set (konstantna vrednost proseka)
baseline_preds = rep(baseline_mean_val, nrow(test_set_processed))
actuals = test_set_processed$log_revenue
print(paste("Izračunata bazna srednja vrednost za predikciju:", round(baseline_mean_val, 4)))
baseline_mae = mean(abs(actuals - baseline_preds))
print(paste("Baseline MAE:", round(baseline_mae, 4)))
baseline_rmse = sqrt(mean((actuals - baseline_preds)^2))
print(paste("Baseline RMSE:", round(baseline_rmse, 4)))
# 4. Izračunavanje R-squared
ss_res = sum((actuals - baseline_preds)^2)
ss_tot = sum((actuals - mean(actuals))^2)
baseline_r2 = 1 - (ss_res / ss_tot)
print(paste("Baseline R-squared:", round(baseline_r2, 4)))
baseline_results_table = data.frame(
Model = "Baseline (Mean Prediction)",
R_squared = round(baseline_r2, 4),
MAE = round(baseline_mae, 4),
RMSE = round(baseline_rmse, 4)
)
knitr::kable(baseline_results_table, caption = "Performanse referentnog (baseline) modela na test setu")
set.seed(123)
# Treniranje linearne regresije korišćenjem 5-fold unakrsne validacije
lr_model = train(
log_revenue ~ . - sales_revenue_usd,
data = train_set_processed,
method = "lm",
trControl = train_control
)
# Prikaz rezultata unakrsne validacije za linearnu regresiju
print(lr_model)
lr_preds = predict(lr_model, newdata = test_set_processed)
actuals  = test_set_processed$log_revenue
# Izračunavanje metrika
lr_mae  = mean(abs(actuals - lr_preds))
lr_rmse = sqrt(mean((actuals - lr_preds)^2))
ss_res = sum((actuals - lr_preds)^2)
ss_tot = sum((actuals - mean(actuals))^2)
lr_r2  = 1 - (ss_res / ss_tot)
# Uporedna tabela performansi
lr_results_table = data.frame(
Model = c("Baseline (Mean Prediction)", "Linear Regression"),
R_squared = round(c(baseline_r2, lr_r2), 4),
MAE = round(c(baseline_mae, lr_mae), 4),
RMSE = round(c(baseline_rmse, lr_rmse), 4)
)
knitr::kable(lr_results_table, caption = "Poređenje performansi Baseline modela i Linearne regresije")
# Ekstrakcija koeficijenata iz modela
model_summary = summary(lr_model$finalModel)
coefs = model_summary$coefficients
coef_df = data.frame(
Variable = rownames(coefs),
Estimate = coefs[, 1],
Std_Error = coefs[, 2],
t_value = coefs[, 3],
p_value = coefs[, 4]
)
rownames(coef_df) = NULL
# Prikaz top 10 najuticajnijih prediktora po apsolutnoj vrednosti koeficijenta
coef_df %>%
filter(Variable != "(Intercept)") %>%
arrange(desc(abs(Estimate))) %>%
head(10) %>%
knitr::kable(caption = "Top 10 koeficijenata linearne regresije")
par(mfrow = c(2, 2))
plot(lr_model$finalModel)
par(mfrow = c(1, 1))
x_train = model.matrix(log_revenue ~ . - sales_revenue_usd, data = train_set_processed)[, -1]
y_train = train_set_processed$log_revenue
x_test  = model.matrix(log_revenue ~ . - sales_revenue_usd, data = test_set_processed)[, -1]
y_test  = test_set_processed$log_revenue
set.seed(123)
cv_ridge = cv.glmnet(x_train, y_train, alpha = 0, nfolds = 5)
best_lambda_ridge = cv_ridge$lambda.min
print(paste("Optimalna Ridge lambda (min):", round(best_lambda_ridge, 6)))
ridge_model = glmnet(x_train, y_train, alpha = 0, lambda = best_lambda_ridge)
set.seed(123)
cv_lasso = cv.glmnet(x_train, y_train, alpha = 1, nfolds = 5)
best_lambda_lasso = cv_lasso$lambda.min
print(paste("Optimalna Lasso lambda (min):", round(best_lambda_lasso, 6)))
lasso_model = glmnet(x_train, y_train, alpha = 1, lambda = best_lambda_lasso)
ridge_preds = predict(ridge_model, newx = x_test)
lasso_preds = predict(lasso_model, newx = x_test)
# Pomoćna funkcija za izračunavanje metrika
calc_metrics = function(actuals, preds) {
mae = mean(abs(actuals - preds))
rmse = sqrt(mean((actuals - preds)^2))
ss_res = sum((actuals - preds)^2)
ss_tot = sum((actuals - mean(actuals))^2)
r2 = 1 - (ss_res / ss_tot)
return(c(MAE = mae, RMSE = rmse, R_squared = r2))
}
ridge_m = calc_metrics(y_test, ridge_preds)
lasso_m = calc_metrics(y_test, lasso_preds)
models_comparison_table = data.frame(
Model = c("Baseline (Mean Prediction)", "Linear Regression", "Ridge Regression", "Lasso Regression"),
R_squared = round(c(baseline_r2, lr_r2, ridge_m["R_squared"], lasso_m["R_squared"]), 4),
MAE = round(c(baseline_mae, lr_mae, ridge_m["MAE"], lasso_m["MAE"]), 4),
RMSE = round(c(baseline_rmse, lr_rmse, ridge_m["RMSE"], lasso_m["RMSE"]), 4)
)
knitr::kable(models_comparison_table, caption = "Poređenje performansi linearnih modela (Baseline, OLS, Ridge, Lasso) na test setu")
set.seed(123)
# Definisanje grid-a za podešavanje cp (complexity parameter)
tree_grid = expand.grid(cp = seq(0.0001, 0.01, length = 10))
# Treniranje stabla odlučivanja uz 5-fold unakrsnu validaciju
tree_model = train(
log_revenue ~ . - sales_revenue_usd,
data = train_set_processed,
method = "rpart",
trControl = train_control,
tuneGrid = tree_grid
)
# Prikaz rezultata unakrsne validacije za stablo odlučivanja
print(tree_model)
# Predikcije na test setu
tree_preds = predict(tree_model, newdata = test_set_processed)
# Izračunavanje metrika za stablo
tree_m = calc_metrics(y_test, tree_preds)
# Uporedna tabela svih modela do sada
all_models_comparison = data.frame(
Model = c("Baseline (Mean Prediction)", "Linear Regression", "Ridge Regression", "Lasso Regression", "Decision Tree"),
R_squared = round(c(baseline_r2, lr_r2, ridge_m["R_squared"], lasso_m["R_squared"], tree_m["R_squared"]), 4),
MAE = round(c(baseline_mae, lr_mae, ridge_m["MAE"], lasso_m["MAE"], tree_m["MAE"]), 4),
RMSE = round(c(baseline_rmse, lr_rmse, ridge_m["RMSE"], lasso_m["RMSE"], tree_m["RMSE"]), 4)
)
knitr::kable(all_models_comparison, caption = "Poređenje performansi svih modela na test setu (uključujući Stablo odlučivanja)")
set.seed(123)
# Definisanje grid-a za podešavanje hiperparametara (mtry)
rf_grid = expand.grid(mtry = c(2,4))
# Treniranje Random Forest modela uz 5-fold unakrsnu validaciju
rf_model = train(
log_revenue ~ . - sales_revenue_usd,
data = train_set_processed,
method = "rf",
trControl = train_control,
tuneGrid = rf_grid,
ntree = 150
)
# Prikaz rezultata unakrsne validacije
print(rf_model)
rf_preds = predict(rf_model, newdata = test_set_processed)
# Izračunavanje metrika za Random Forest
rf_m = calc_metrics(y_test, rf_preds)
# Proširena uporedna tabela svih modela
all_models_comparison_rf = data.frame(
Model = c("Baseline", "Linear Regression", "Ridge", "Lasso", "Decision Tree", "Random Forest"),
R_squared = round(c(baseline_r2, lr_r2, ridge_m["R_squared"], lasso_m["R_squared"], tree_m["R_squared"], rf_m["R_squared"]), 4),
MAE = round(c(baseline_mae, lr_mae, ridge_m["MAE"], lasso_m["MAE"], tree_m["MAE"], rf_m["MAE"]), 4),
RMSE = round(c(baseline_rmse, lr_rmse, ridge_m["RMSE"], lasso_m["RMSE"], tree_m["RMSE"], rf_m["RMSE"]), 4)
)
knitr::kable(all_models_comparison_rf, caption = "Poređenje performansi svih modela uključujući Random Forest")
set.seed(123)
# Definisanje manjeg grid-a za GBM kako bi se trening optimizovao
gbm_grid = expand.grid(
interaction.depth = c(3, 5),
n.trees = c(150),
shrinkage = c(0.1),
n.minobsinnode = c(10)
)
# Treniranje GBM modela uz 5-fold unakrsnu validaciju
gbm_model = train(
log_revenue ~ . - sales_revenue_usd,
data = train_set_processed,
method = "gbm",
trControl = train_control,
tuneGrid = gbm_grid,
verbose = FALSE
)
# Prikaz rezultata unakrsne validacije
print(gbm_model)
gbm_preds = predict(gbm_model, newdata = test_set_processed)
# Izračunavanje metrika za GBM
gbm_m = calc_metrics(y_test, gbm_preds)
# Kreiranje finalne uporedne tabele svih modela
final_models_comparison = data.frame(
Model = c("Baseline", "Linear Regression", "Ridge", "Lasso", "Decision Tree", "Random Forest", "GBM/XGBoost"),
R_squared = round(c(baseline_r2, lr_r2, ridge_m["R_squared"], lasso_m["R_squared"], tree_m["R_squared"], rf_m["R_squared"], gbm_m["R_squared"]), 4),
MAE = round(c(baseline_mae, lr_mae, ridge_m["MAE"], lasso_m["MAE"], tree_m["MAE"], rf_m["MAE"], gbm_m["MAE"]), 4),
RMSE = round(c(baseline_rmse, lr_rmse, ridge_m["RMSE"], lasso_m["RMSE"], tree_m["RMSE"], rf_m["RMSE"], gbm_m["RMSE"]), 4)
)
knitr::kable(final_models_comparison, caption = "Konačno poređenje performansi svih modela na test setu")
# Generisanje predikcija i reziduala na test setu za linearnu regresiju
test_preds = predict(lr_model, newdata = test_set_processed)
test_residuals = test_set_processed$log_revenue - test_preds
res_df = data.frame(
Actual = test_set_processed$log_revenue,
Predicted = test_preds,
Residuals = test_residuals
)
# Grafikon: Residuals vs Predicted
ggplot(res_df, aes(x = Predicted, y = Residuals)) +
geom_point(alpha = 0.5, color = "steelblue") +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
geom_smooth(method = "loess", se = FALSE, color = "darkorange") +
labs(title = "Residuals vs Predicted na test setu",
x = "Prediktovane vrednosti (log_revenue)",
y = "Reziduali (Stvarno - Predikcija)") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 11))
ggplot(res_df, aes(sample = Residuals)) +
stat_qq(color = "steelblue", alpha = 0.6) +
stat_qq_line(color = "red", linetype = "dashed") +
labs(title = "Normal Q-Q Plot reziduala na test setu",
x = "Teoretski kvantili",
y = "Uzorci kvantili (Reziduali)") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 11))
res_df[, "Abs_Residuals"] = abs(res_df[, "Residuals"])
extreme_errors = res_df[order(-res_df[, "Abs_Residuals"]), ]
knitr::kable(
head(extreme_errors[, c("Actual", "Predicted", "Residuals", "Abs_Residuals")], 5),
caption = "Top 5 opservacija sa najvećom greškom predviđanja na test setu"
)
mean_bias = mean(test_residuals)
print(paste("Prosečna greška (Bias) na test setu:", round(mean_bias, 6)))
# Izračunavanje značajnosti varijabli za caret train model
importance_scores = varImp(rf_model, scale = FALSE)
# Pretvaranje u data frame
rf_imp_df = data.frame(
Variable = rownames(importance_scores$importance),
Importance = importance_scores$importance[, 1]
)
# Sortiranje u opadajućem redosledu
rf_imp_df = rf_imp_df[order(-rf_imp_df$Importance), ]
# Vizuelizacija top 10 najvažnijih varijabli
ggplot(head(rf_imp_df, 10), aes(x = reorder(Variable, Importance), y = Importance)) +
geom_col(fill = "steelblue") +
coord_flip() +
labs(title = "Top 10 najvažnijih varijabli (Random Forest)",
x = "Varijable",
y = "Značajnost") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 11))
# 1. Izračunavanje permutacione važnosti sa pred_wrapper-om
pfun = function(object, newdata) {
predict(object, newdata = newdata)
}
perm_imp = vi(rf_model, method = "permute",
train = test_set_processed,
target = "log_revenue",
metric = "RMSE",
pred_wrapper = pfun)
# 2. Ručno crtanje preko ggplot2 (zaobilazi grešku sa xlim)
ggplot(head(perm_imp, 10), aes(x = reorder(Variable, Importance), y = Importance)) +
geom_col(fill = "steelblue") +
coord_flip() +
labs(title = "Permutaciona važnost varijabli (Test set)",
x = "Varijable",
y = "Povećanje greške (RMSE)") +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 11))
comparison_summary = data.frame(
Rank = 1:5,
Random_Forest = c("customer_segmentNew", "customer_segmentRegular", "product_categoryElectronics", "conversion_rate", "customer_segmentVIP"),
Permutation_Importance = c("customer_segment", "product_category", "season", "sales_channel", "num_previous_purchases")
)
knitr::kable(
comparison_summary,
caption = "Poređenje vodećih prediktora po različitim metodama značajnosti"
)
