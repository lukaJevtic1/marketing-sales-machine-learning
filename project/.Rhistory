library(skimr)
library(knitr)
dataset=read.csv("marketing_sales_dataset.csv",header = T)
nrow=function(x) dim(x)[1]
ncol=function(x) dim(x)[2]
print(paste("Broj kolona je:", ncol(dataset)))
print(paste("Broj redova je:", nrow(dataset)))
head(dataset)
names(dataset)
str(dataset)
summary(dataset)
skim(dataset)
opis_kolona=data.frame(
Kolona = c(
"id", "date", "region", "sales_channel", "product_category",
"customer_segment", "season", "marketing_budget_usd", "ad_spend_online_usd",
"ad_spend_offline_usd", "num_promotions", "discount_percentage",
"num_sales_representatives", "customer_age", "customer_satisfaction_score",
"competitor_price_index", "website_traffic", "conversion_rate",
"email_open_rate", "social_media_followers", "days_since_last_purchase",
"num_previous_purchases", "sales_revenue_usd"
),
Opis = c(
"Jedinstveni identifikacioni broj transakcije.",
"Datum izvršene transakcije.",
"Geografski region u okviru MENA tržišta (Riyadh, Dubai, Cairo, Abu Dhabi, Jeddah, Doha, Kuwait City).",
"Kanal preko kojeg je obavljena prodaja (npr. Online, Retail Store).",
"Kategorija proizvoda (Cosmetics, Electronics, Food & Beverage, itd.).",
"Tip ili segment kupca (Regular, New, Corporate, VIP).",
"Sezonski period / kvartal u godini (Q1, Q2, Q3, Q4).",
"Ukupan opredeljeni marketinški budžet u dolarima.",
"Finansijska sredstva uložena u online oglašavanje.",
"Finansijska sredstva uložena u offline marketinške kampanje.",
"Broj aktivnih promotivnih ponuda ili akcija tokom transakcije.",
"Procenat odobrenog popusta (sa prisutnim nedostajućim vrednostima NA).",
"Broj angažovanih prodajnih predstavnika.",
"Starost kupca u godinama.",
"Ocena zadovoljstva kupca na skali od 1 do 5 (NA vrednosti).",
"Indeks cene konkurencije u odnosu na naš proizvod.",
"Saobraćaj / posete veb-sajtu.",
"Stopa konverzije posetilaca u kupce.",
"Procenat otvaranja promotivnih mejlova (NA vrednosti).",
"Broj pratilaca brenda na društvenim mrežama.",
"Broj proteklih dana od poslednje kupovine istog kupca (NA vrednosti).",
"Ukupan broj prethodnih kupovina koje je kupac ostvario.",
"Ostvareni prihod od prodaje u dolarima (ciljna promenljiva - target)."
)
)
kable(opis_kolona, col.names = c("Naziv kolone", "Opis promenljive"))
missing_value_counts = colSums(is.na(dataset))
missing_value_percentages = round((missing_value_counts / nrow(dataset)) * 100, 2)
missing_values_summary=data.frame(
Naziv_Kolone = names(missing_value_counts),
Broj_NA = missing_value_counts,
Procenat_NA = missing_value_percentages
)
missing_values_filtered = missing_values_summary[missing_values_summary$Broj_NA > 0, ]
kable(missing_values_filtered, col.names = c("Naziv Kolone ", "Broj NA", "Procenat NA (%)"))
total_missing_values = sum(is.na(dataset))
rows_with_missing = sum(rowSums(is.na(dataset)) > 0)
rows_with_missing_percentage = round((rows_with_missing / nrow(dataset)) * 100, 2)
print(paste("Ukupan broj nedostajućih polja:", total_missing_values))
print(paste("Broj redova sa najmanje jednom Na vrednošću:", rows_with_missing))
print(paste("Procenat redova sa najmanje jednom Na vrednošću:", rows_with_missing_percentage, "%"))
total_duplicate_rows <- sum(duplicated(dataset))
print(paste("Ukupan broj dupliranih redova u dataset-u:", total_duplicate_rows))
categorical_columns = names(dataset)[sapply(dataset, is.character)]
unique_categories_count = sapply(dataset[categorical_columns], function(x) length(unique(x)))
print("Broj jedinstvenih vrednosti po kategorijskim kolonama:")
print(unique_categories_count)
dataset_cleaned = dataset
dataset_cleaned$discount_percentage[is.na(dataset_cleaned$discount_percentage)] = median(dataset_cleaned$discount_percentage, na.rm = TRUE)
dataset_cleaned$customer_satisfaction_score[is.na(dataset_cleaned$customer_satisfaction_score)]= median(dataset_cleaned$customer_satisfaction_score, na.rm = TRUE)
dataset_cleaned$email_open_rate[is.na(dataset_cleaned$email_open_rate)]= median(dataset_cleaned$email_open_rate, na.rm = TRUE)
dataset_cleaned$days_since_last_purchase[is.na(dataset_cleaned$days_since_last_purchase)]= median(dataset_cleaned$days_since_last_purchase, na.rm = TRUE)
print(paste("Ukupan broj NA vrednosti preostalih nakon imputacije:", sum(is.na(dataset_cleaned))))
dataset_cleaned = dataset_cleaned %>% filter(sales_revenue_usd >= 0, marketing_budget_usd >= 0)
factor_columns_list = c("region", "sales_channel", "product_category", "customer_segment", "season")
for (col in factor_columns_list) {
dataset_cleaned[[col]] = as.factor(dataset_cleaned[[col]])
}
# Uklanjanje identifikatora (id) i datuma (date) jer nemaju direktnu prediktivnu vrednost
# u standardnim regresionim modelima (sezonalnost je već pokrivena kolonom 'season')
dataset_for_modeling <- dataset_cleaned %>% select(-id, -date)
ggplot(dataset_cleaned, aes(y = sales_revenue_usd)) +
geom_boxplot(fill = "skyblue", color = "darkblue", outlier.color = "red", outlier.shape = 16) +
labs(title = "Boxplot prikaz prihoda od prodaje - Detekcija autlajera",
y = "Sales Revenue (USD)") +
theme_minimal()
par(mfrow = c(1, 2))
# Histogram originalnih vrednosti prihoda (sa izraženom desnom asimetričnošću)
hist(dataset_cleaned$sales_revenue_usd,
main = "Originalni prihodi",
xlab = "Sales Revenue",
col = "orange",
breaks = 50)
dataset_for_modeling$log_sales_revenue_usd = log(dataset_for_modeling$sales_revenue_usd + 1)
# Histogram transformisanih vrednosti prihoda
hist(dataset_for_modeling$log_sales_revenue_usd,
main = "Log-transformisani prihodi",
xlab = "Log(Sales Revenue + 1)",
col = "forestgreen",
breaks = 50)
par(mfrow = c(1, 1))
str(dataset_for_modeling)
summary(dataset_for_modeling$sales_revenue_usd)
summary(dataset_for_modeling$log_sales_revenue_usd)
ggplot(dataset_cleaned, aes(y = sales_revenue_usd)) +
geom_boxplot(fill = "skyblue", color = "darkblue", outlier.color = "red", outlier.shape = 16) +
labs(title = "Boxplot prikaz prihoda od prodaje - Detekcija autlajera",
y = "Sales Revenue (USD)") +
theme_minimal()
dataset_for_modeling$log_sales_revenue_usd = log(dataset_for_modeling$sales_revenue_usd + 1)
# Postavljanje prikaza u dva dela (obavezno u istom ćunku!)
par(mfrow = c(1, 2))
# 1. Histogram originalnih vrednosti prihoda
hist(dataset_cleaned$sales_revenue_usd,
main = "Originalni prihodi",
xlab = "Sales Revenue",
col = "orange",
breaks = 50)
# 2. Histogram transformisanih vrednosti prihoda
hist(dataset_for_modeling$log_sales_revenue_usd,
main = "Log-transformisani prihodi",
xlab = "Log(Sales Revenue + 1)",
col = "forestgreen",
breaks = 50)
# Vraćanje grafičkog prikaza na podrazumevano stanje (1 prozor)
par(mfrow = c(1, 1))
