missingness_data[[indicator_name]] == 1,
"Missing",
"Available"
)
temp = data.frame(
Status = status,
Revenue = missingness_data$sales_revenue_usd
)
summary_temp = temp %>%
group_by(Status) %>%
summarise(
Number_of_rows = n(),
Mean_revenue = mean(Revenue),
Median_revenue = median(Revenue)
)
summary_temp$Missing_variable = variable
target_comparison = rbind(
target_comparison,
summary_temp[, c(
"Missing_variable",
"Status",
"Number_of_rows",
"Mean_revenue",
"Median_revenue"
)]
)
}
target_comparison
